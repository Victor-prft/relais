# Copier en .env et remplir. Ne jamais commiter .env.

# development | production
NODE_ENV=development
PORT=3100
# URL publique (liens des notifications, emails futurs)
APP_URL=http://localhost:3100

# Base SQLite. En prod Railway : /data/relais.db (volume monté sur /data)
DATABASE_PATH=./db/relais.db

# Secret des cookies de session : 32 caractères minimum en production.
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Démo / portfolio : comptes affichés sur la page de connexion (défaut : actif hors prod)
DEMO_MODE=true
# Base vide au démarrage → jeu de démo complet
SEED_ON_EMPTY=false

# Premier administrateur, créé au démarrage s'il n'existe aucun admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# IA (côté serveur uniquement). Sans clé, les fonctions IA se désactivent proprement.
ANTHROPIC_API_KEY=
# Modèle utilisé pour le tri, les suggestions et les résumés
ANTHROPIC_MODEL=claude-haiku-4-5

# Tâches planifiées (SLA, clôture auto). Défaut : actif hors tests.
CRON_ENABLED=true
# Couche email : aucun envoi tant que ce n'est pas branché sur un fournisseur.
EMAIL_ENABLED=false
