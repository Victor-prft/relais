{
  "name": "relais",
  "version": "0.4.0",
  "private": true,
  "description": "Plateforme ITSM inspirée d'ITIL : incidents, demandes, changements, CMDB, SLA, base de connaissances",
  "main": "server.js",
  "type": "commonjs",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test \"test/*.test.js\"",
    "test:watch": "node --test --watch \"test/*.test.js\"",
    "db:migrate": "node db/migrate.js",
    "db:seed": "node db/seed.js",
    "vendor": "node tools/copy-vendor.js",
    "icons": "node tools/make-icons.js",
    "postinstall": "node tools/copy-vendor.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.11.1",
    "chart.js": "^4.5.1",
    "cytoscape": "^3.34.3",
    "dompurify": "^3.4.16",
    "dotenv": "^16.4.7",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "gridstack": "^14.0.0",
    "marked": "^18.0.14",
    "node-cron": "^4.6.0",
    "zod": "^4.6.5"
  }
}
